{
  "name": "icon-studio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:api": "npx --yes vercel dev --listen 3000",
    "dev:full": "concurrently \"npm run dev -w client\" \"npm run dev:api\"",
    "build": "npm run build -w client && npm run build -w server",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w client && npm run typecheck -w server && npm run typecheck:api",
    "typecheck:api": "tsc -p api --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:edge": "deno test --config supabase/functions/chat/deno.json --allow-env supabase/functions/chat/",
    "test:all": "npm run test && npm run test:edge",
    "check:edge": "deno check --config supabase/functions/chat/deno.json supabase/functions/chat/index.ts evals/run.ts && deno lint --config supabase/functions/chat/deno.json supabase/functions/chat/",
    "eval": "deno run --allow-net --allow-env --allow-read --config supabase/functions/chat/deno.json evals/run.ts",
    "deploy:chat": "supabase functions deploy chat --project-ref anysbhiiwsnuzksrlvtf",
    "migrate:status": "node scripts/migrate-status.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/node": {
      "path-to-regexp": "^6.3.0"
    },
    "@vercel/python-analysis": {
      "js-yaml": "^4.2.1",
      "minimatch": "^10.2.3",
      "smol-toml": "^1.6.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@vercel/node": "^5.9.5",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "puppeteer": "^25.5.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@sentry/node": "^10.54.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.60.1"
  }
}
