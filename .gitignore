# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/
.vercel/

# Environment files — never commit secrets
.env
.env.local
.env.*.local
.env.*
*.local

# ...except the template, which holds key names and comments but no values.
# Must come after .env.* — the last matching pattern wins.
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# Misc
*.log

# Claude Code
.claude/

# These rules are anchored with a leading slash so they match ONLY the
# directory at the repo root. Unanchored, `scripts/` matched every directory
# named "scripts" at any depth — including server/src/scripts/, which holds
# real application code. server/src/scripts/seed.ts survives only because it
# was tracked before the rule existed; any NEW file added there would have been
# silently invisible to `git add`, which is exactly how the six untracked
# modules got missed.

# Print assets
/Html & Images/

# Non-project misc files
/_misc/

# Raw source images (originals — gallery copies live in client/public/gallery/)
/images/

# Scratch/temp scripts
/scratch/
/scripts/

/graphify-out
.claude/agents/