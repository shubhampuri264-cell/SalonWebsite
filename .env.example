# Icon Studio — environment template.
#
# Copy to .env for local work, and set the same keys in the Vercel project
# (Settings -> Environment Variables) for deploys. Never commit a filled-in .env.
#
# Do NOT wrap values in quotes. dotenv strips them locally, Vercel does not, so
# a quoted value behaves differently in production than on your laptop.
# api/_lib/env.ts defends against this, but the habit is the real fix.
#
# NODE_ENV is deliberately absent. Setting it here makes `vite build` bundle the
# development build of React into production. Vercel sets it for deploys.

# --- Server / API ---------------------------------------------------------
PORT=5000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Resend. Free tier is 100 emails/day, shared across booking confirmations,
# owner notifications, reminders, follow-ups and the contact form.
RESEND_API_KEY=
EMAIL_FROM=

# Owner login email. Doubles as the admin authorisation check
# (api/_lib/auth.ts) and the recipient for new-booking and contact-form mail.
# Must exactly match the Supabase Auth account used to sign in to /admin.
OWNER_EMAIL=

CLIENT_URL=http://localhost:5173
SALON_TIMEZONE=America/New_York

# Shared secret for the daily cron (api/cron/reminders.ts). The job refuses to
# run when this is unset, so an empty value silently disables reminders.
CRON_SECRET=

GOOGLE_REVIEW_URL=

# --- Error tracking (REQUIRED in production) ------------------------------
# Without these, all 14 captureError() call sites in api/ and every client-side
# ErrorBoundary report degrade to console.error, and nothing alerts. That is
# the difference between "the reminder cron has been failing for a week" being
# noticed and not.
#
# Create a project at https://sentry.io -> Projects -> Create Project.
#   SENTRY_DSN      — pick platform "Node.js"  (used by api/_lib/sentry.ts)
#   VITE_SENTRY_DSN — pick platform "React"    (used by client/src/sentry.ts)
# Two separate projects, two separate DSNs. Set both in Vercel for Production.
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Rate limiting --------------------------------------------------------
# Free Regional Redis DB at https://console.upstash.com/redis, then copy the
# REST API credentials from the database overview page.
# Missing in production means every limited endpoint fails CLOSED with a 503 —
# by design, so a misconfiguration is loud rather than unprotected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Internal service auth -------------------------------------------------
# Shared secret proving a request came from our own Iris Edge Function on
# Supabase, sent as the X-Internal-Token header. Set the SAME value here and in
# the Supabase function secrets.
#
# It authenticates the SERVICE, never the customer: it is used only to pick a
# rate-limit bucket (chat traffic all arrives from Supabase's egress IPs, which
# would otherwise share one budget). Every endpoint that touches a booking still
# requires that customer's own Bearer token. Never treat this as authorisation.
#
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=

# --- Iris, the AI assistant -------------------------------------------------
# Iris runs as a Supabase Edge Function (supabase/functions/chat), NOT on
# Vercel. That is deliberate: Vercel's Hobby plan caps the project at 12
# serverless functions and all 12 are in use, so adding chat there would have
# meant merging two existing endpoints and risking the browse/book path.
#
# The keys below therefore live in THREE places, and each one wants a different
# subset. Setting a key in the wrong place fails silently.
#
#   Supabase function secrets   `supabase secrets set KEY=value`
#     ANTHROPIC_API_KEY         from console.anthropic.com. Unset = free text
#                               stops working; the MENU still books, cancels,
#                               reschedules and shows prices. Iris degrades, the
#                               site does not.
#     CHAT_ENABLED              "false" is the kill switch. Same degraded state
#                               as an unset key, without rotating anything.
#     UPSTASH_REDIS_REST_URL    same values as the Vercel side. Sessions, rate
#     UPSTASH_REDIS_REST_TOKEN  limits and pending bookings all live in Redis;
#                               without these the limiters fail CLOSED in prod.
#     INTERNAL_API_TOKEN        must MATCH the Vercel value exactly.
#     VERCEL_API_BASE           e.g. https://iconstudio.vercel.app — no trailing
#                               slash. Where booking/availability calls go.
#     CLIENT_URL                the CORS allowlist. Never "*".
#     SALON_TIMEZONE            America/New_York.
#     ENVIRONMENT               "production" makes the limiters fail closed.
#   (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.)
#
#   Vercel        INTERNAL_API_TOKEN (above, in "Internal service auth")
#   Client        the two VITE_ keys at the bottom of this file
#
# Model costs, at roughly 200 conversations a month: about $8-9. The classifier
# is Haiku 4.5 (~$0.60) and the main model is Sonnet 5 with prompt caching.
ANTHROPIC_API_KEY=
CHAT_ENABLED=true

# --- SMS (optional, off by default) ---------------------------------------
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Client (VITE_ prefix is exposed to the browser — no secrets here) -----
# Dev only, and normally LEFT EMPTY. `npm run dev:full` proxies /api to
# `vercel dev` (see client/vite.config.ts), so relative paths work in dev
# exactly as they do in production, where client and API are one Vercel project.
# Set this only to point at a backend on a different origin — and then it must
# be an ABSOLUTE origin (http://host:port). A relative value like "/api" gets
# prefixed onto paths that already start with /api, producing
# /api/api/services; non-absolute values are ignored with a console warning.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Iris. The function URL is https://<project-ref>.supabase.co/functions/v1/chat
# — already permitted by the CSP, which allows https://*.supabase.co
# (vercel.json), so no header change is needed.
#
# VITE_CHAT_ENABLED=false removes the widget from the page entirely. The site
# and the booking wizard are completely unaffected either way; Iris is an
# addition, never a replacement.
VITE_CHAT_URL=
VITE_CHAT_ENABLED=true
