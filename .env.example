# Icon Studio — environment template.
#
# Copy to .env for local work, and set the same keys in the Vercel project
# (Settings -> Environment Variables) for deploys. Never commit a filled-in .env.
#
# Do NOT wrap values in quotes. dotenv strips them locally, Vercel does not, so
# a quoted value behaves differently in production than on your laptop.
# api/_lib/env.ts defends against this, but the habit is the real fix.
#
# NODE_ENV is deliberately absent. Setting it here makes `vite build` bundle the
# development build of React into production. Vercel sets it for deploys.

# --- Server / API ---------------------------------------------------------
PORT=5000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Resend. Free tier is 100 emails/day, shared across booking confirmations,
# owner notifications, reminders, follow-ups and the contact form.
RESEND_API_KEY=
EMAIL_FROM=

# Owner login email. Doubles as the admin authorisation check
# (api/_lib/auth.ts) and the recipient for new-booking and contact-form mail.
# Must exactly match the Supabase Auth account used to sign in to /admin.
OWNER_EMAIL=

CLIENT_URL=http://localhost:5173
SALON_TIMEZONE=America/New_York

# Shared secret for the daily cron (api/cron/reminders.ts). The job refuses to
# run when this is unset, so an empty value silently disables reminders.
CRON_SECRET=

GOOGLE_REVIEW_URL=

# --- Error tracking (REQUIRED in production) ------------------------------
# Without these, all 14 captureError() call sites in api/ and every client-side
# ErrorBoundary report degrade to console.error, and nothing alerts. That is
# the difference between "the reminder cron has been failing for a week" being
# noticed and not.
#
# Create a project at https://sentry.io -> Projects -> Create Project.
#   SENTRY_DSN      — pick platform "Node.js"  (used by api/_lib/sentry.ts)
#   VITE_SENTRY_DSN — pick platform "React"    (used by client/src/sentry.ts)
# Two separate projects, two separate DSNs. Set both in Vercel for Production.
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Rate limiting --------------------------------------------------------
# Free Regional Redis DB at https://console.upstash.com/redis, then copy the
# REST API credentials from the database overview page.
# Missing in production means every limited endpoint fails CLOSED with a 503 —
# by design, so a misconfiguration is loud rather than unprotected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- SMS (optional, off by default) ---------------------------------------
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Client (VITE_ prefix is exposed to the browser — no secrets here) -----
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=
